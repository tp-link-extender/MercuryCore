{
	"name": "mercurycore",
	"type": "module",
	"scripts": {
		"build": "bun x -b vite build",
		"buildview": "bun x -b vite build && bun x -b vite preview",
		"dev": "bun x -b vite dev",
		"format": "biome format src --write",
		"lint": "oxlint --fix && biome check --fix",
		"list": "bun x pm2 list",
		"logs": "bun x pm2 logs",
		"preview": "bun x -b vite preview",
		"prod": "bun i -p && bun x -b vite build",
		"serve": "bun x pm2 start",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.json",
		"svelte:check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"@unocss/extractor-svelte": "^66.12.0",
		"@unocss/preset-tagify": "^66.12.0",
		"@unocss/transformer-directives": "^66.12.0",
		"@unocss/transformer-variant-group": "^66.12.0",
		"arktype": "^2.2.9",
		"d3-interpolate": "^3.0.2",
		"economy": "file:../Economy/client",
		"melt": "^0.44.0",
		"nodemailer": "^10.3.1",
		"nprogress": "^0.2.0",
		"picocolors": "^1.1.1",
		"sharp": "^0.35.5",
		"stripe-gradient": "^1.0.1",
		"surrealdb": "^2.2.2",
		"svelte": "^5.57.3",
		"svelte-inview": "^4.0.5",
		"sveltekit-superforms": "^2.31.0",
		"typescript": "^7.0.2",
		"unocss": "^66.12.0",
		"vite": "^8.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"@types/d3-interpolate": "^3.0.4",
		"@types/nodemailer": "^8.0.2",
		"@types/nprogress": "^0.2.3",
		"oxlint": "^1.92.0",
		"oxlint-tsgolint": "^7.0.2006",
		"svelte-check": "^4.7.8",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@sveltejs/kit",
		"esbuild",
		"sharp"
	]
}
