ORIGIN=https://mercs.dev
PORT=4443
# The Site should only be reachable through Caddy. Caddy puts the client's address last in X-Forwarded-For, which ratelimits are keyed on. Don't set ADDRESS_HEADER if clients can reach the Site directly.
HOST=127.0.0.1
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# https://svelte.dev/docs/kit/adapter-bun#Request-limits-and-diagnostics
BODY_SIZE_LIMIT=1G
EMAIL_PASSWORD=password
# Shared key for the Orbiter, which runs gameservers and renders: at least 16 characters, and not an example value, or requests that use it are refused. Must match ORBITER_KEY in the Orbiter's .env. Use `openssl rand -hex 32`.
ORBITER_KEY=change-me
OPEN_CLOUD_KEY=whatever
# Shared secret for the Economy service; must match ECONOMY_KEY on the Economy service.
ECONOMY_KEY=password
# The database user the Site connects as, limited to the main database. Create it with `bun run db:setup`, which the Site also does itself when Database.AutoStart is on. Passwords are at least 32 letters, digits, underscores or hyphens; use `openssl rand -hex 32`.
DATABASE_USER=site
DATABASE_PASSWORD=change-me
# SurrealDB's root password. Only needed by `bun run db:setup` and when Database.AutoStart is on.
DATABASE_ROOT_PASSWORD=change-me

# The password, port, and Orbiter key may be changed if required.
