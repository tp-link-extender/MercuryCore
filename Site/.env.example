ORIGIN=https://mercs.dev
PORT=4443
# The Site should only be reachable through Caddy. Caddy puts the client's address last in X-Forwarded-For, which ratelimits are keyed on. Don't set ADDRESS_HEADER if clients can reach the Site directly.
HOST=127.0.0.1
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# https://svelte.dev/docs/kit/adapter-node#Environment-variables-BODY_SIZE_LIMIT
BODY_SIZE_LIMIT=1G
EMAIL_PASSWORD=password
RCC_KEY=password
GAMESERVER_KEY=password
OPEN_CLOUD_KEY=whatever
# Shared secret for the Economy service; must match ECONOMY_KEY on the Economy service.
ECONOMY_KEY=password

# The password, port, and RCCService key may be changed if required.
