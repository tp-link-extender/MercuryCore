# Used by compose to configure secrets for the database, Site and Economy services.
# Copy this file to .env and replace each value with a long, random string from `openssl rand -hex 32`.
ECONOMY_KEY=password
# SurrealDB's root password. Only the database and database-setup services get it.
DATABASE_ROOT_PASSWORD=change-me
# The database user the Site connects as. It can only use the main database.
DATABASE_USER=site
DATABASE_PASSWORD=change-me
